@startuml
start
:Получить запрос /api/recommendations/{userId};
if (БД доступна?) then (да)
  :Загрузить активные динамические правила из БД;
else (нет)
  :Использовать только статические правила (StaticRules);
endif
:Объединить статические и динамические правила;
:Для каждого правила проверить условия (checkRuleConditions);
if (условия выполнены?) then (да)
  :Добавить рекомендацию в список;
  if (правило динамическое?) then (да)
    :Увеличить applyCount;
    :Сохранить правило в БД;
  endif
else (нет)
  :Пропустить правило;
endif
repeat while (не проверены все правила)
:Вернуть список рекомендаций;
stop
@enduml
